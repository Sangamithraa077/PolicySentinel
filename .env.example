# Copy this file to .env and fill in real values. Never commit .env.
#
# Note on DATABASE_URL / NEO4J_URI below: these "localhost" forms are for
# running the backend directly on the host (outside Docker), e.g. local
# tooling or Alembic. When running via docker-compose.yml, the backend
# container is given its own DATABASE_URL/NEO4J_URI pointing at the
# "postgres"/"neo4j" service names instead — see docker-compose.yml.

# --- Docker Compose project/build ---
COMPOSE_PROJECT_NAME=policysentinel
BACKEND_TARGET=development
FRONTEND_TARGET=development

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=changeme

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log

# --- Backend / API ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
# In production (e.g. the Render backend service), this must be set to the
# deployed frontend's exact origin(s) — scheme + host, no trailing slash,
# comma-separated for multiple (e.g. an onrender.com URL plus a Vercel
# domain). A missing/wrong value here is a silent failure: the backend
# still responds 200, it just omits Access-Control-Allow-Origin, so the
# browser discards the response before your frontend code ever sees it.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=policysentinel
POSTGRES_USER=policysentinel
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://policysentinel:changeme@localhost:5432/policysentinel

# Connection pool sizing (SQLAlchemy QueuePool). DB_POOL_SIZE + DB_MAX_OVERFLOW
# is the ceiling on concurrent connections this process holds open — keep it
# comfortably under Postgres's own max_connections, especially if you run
# multiple backend workers/replicas against the same database.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_PAGECACHE_SIZE=512M
NEO4J_HEAP_MAX_SIZE=1G

# --- JWT Auth ---
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Claude API ---
ANTHROPIC_API_KEY=changeme
CLAUDE_MODEL=claude-sonnet-5

# --- Gemini API ---
GEMINI_API_KEY=changeme
GEMINI_MODEL=gemini-2.5-flash

# --- File Uploads ---
# Relative to the backend working directory (backend/ locally, /app in the container).
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_PORT=3000
